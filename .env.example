# Node 22+. Render supplies PORT automatically.
PORT=3000
# Only needed for a frontend hosted on a separate origin. Comma separated HTTPS origins.
ALLOWED_ORIGINS=
# Optional durable room checkpoints; keep BOTH values server-side.
UPSTASH_REDIS_REST_URL=
UPSTASH_REDIS_REST_TOKEN=
ROOM_STORE_NAMESPACE=daketi:v2
# Optional development-only file persistence. Render's local disk is ephemeral.
# ROOM_STORE_FILE=.data/rooms.json
